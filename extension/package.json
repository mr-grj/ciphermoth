{
  "name": "ciphermoth-extension",
  "version": "3.8.0",
  "private": true,
  "type": "module",
  "description": "Fill logins from your self-hosted CipherMoth vault.",
  "license": "MIT",
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:test": "node scripts/build.mjs --test",
    "package": "node scripts/build.mjs --package",
    "verify": "node scripts/verify.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:firefox": "web-ext lint --source-dir dist/firefox --self-hosted",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,mjs,html}\" \"scripts/**/*.mjs\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,html}\" \"tests/**/*.{ts,mjs,html}\" \"scripts/**/*.mjs\"",
    "test": "vitest run",
    "test:e2e": "node scripts/build.mjs --test && playwright test"
  },
  "dependencies": {
    "preact": "10.29.8"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "11.0.4"
    },
    "deepmerge": "$deepmerge"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/space-mono": "5.3.0",
    "@playwright/test": "1.64.1",
    "@types/chrome": "0.3.7",
    "deepmerge": "file:vendor/deepmerge",
    "esbuild": "0.28.2",
    "eslint": "9.39.5",
    "globals": "17.14.0",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12",
    "web-ext": "10.8.0"
  }
}
